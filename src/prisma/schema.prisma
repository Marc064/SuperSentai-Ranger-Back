generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Saga {
  idSaga    Int         @id @default(autoincrement()) @map("ID_SAGA")
  saga      String      @map("SAGA") @db.VarChar(100)
  URL       String?     @db.Text
  IMAGEN    String?     @db.Text
  Temporada Temporada[]

  @@map("SAGA")
}

model Tipo {
  idTipo    Int         @id @default(autoincrement()) @map("ID_TIPO")
  tipo      String      @map("TIPO") @db.VarChar(50)
  Temporada Temporada[]

  @@map("TIPO")
}

model Tematica {
  idTematica         Int                  @id @default(autoincrement()) @map("ID_TEMATICA")
  tematica           String               @map("TEMATICA") @db.VarChar(250)
  TEMPORADA_TEMATICA TEMPORADA_TEMATICA[]

  @@map("TEMATICA")
}

model Temporada {
  idTemporada        Int                  @id @default(autoincrement()) @map("ID_TEMPORADA")
  titulo             String               @map("TITULO") @db.VarChar(250)
  estreno            Int                  @map("ESTRENO") @db.Year
  imagen             String               @map("IMAGEN") @db.Text
  visto              Int                  @map("VISTO")
  episodios          Int                  @map("EPISODIOS")
  duracionVisto      DateTime             @map("DURACION_VISTO") @db.Time(0)
  link               String?              @map("LINK") @db.Text
  completado         String               @map("COMPLETADO") @db.Char(1)
  idTipo             Int                  @map("ID_TIPO")
  idSaga             Int                  @map("ID_SAGA")
  tipo               Tipo                 @relation(fields: [idTipo], references: [idTipo], onDelete: NoAction, onUpdate: NoAction, map: "TEMPORADA_ibfk_1")
  saga               Saga                 @relation(fields: [idSaga], references: [idSaga], onDelete: NoAction, onUpdate: NoAction, map: "TEMPORADA_ibfk_2")
  TEMPORADA_TEMATICA TEMPORADA_TEMATICA[]

  @@index([idSaga], map: "ID_SAGA")
  @@index([idTipo], map: "ID_TIPO")
  @@map("TEMPORADA")
}

model TEMPORADA_TEMATICA {
  ID_TEMPORADA_TEMATICA Int       @id @default(autoincrement())
  ID_TEMPORADA          Int
  ID_TEMATICA           Int
  TEMPORADA             Temporada @relation(fields: [ID_TEMPORADA], references: [idTemporada], onDelete: NoAction, onUpdate: NoAction, map: "TEMPORADA_TEMATICA_ibfk_1")
  TEMATICA              Tematica  @relation(fields: [ID_TEMATICA], references: [idTematica], onDelete: NoAction, onUpdate: NoAction, map: "TEMPORADA_TEMATICA_ibfk_2")

  @@index([ID_TEMATICA], map: "ID_TEMATICA")
  @@index([ID_TEMPORADA], map: "ID_TEMPORADA")
}
